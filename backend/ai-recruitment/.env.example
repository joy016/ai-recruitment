# Copy to .env (gitignored) for local overrides, or set these as real environment
# variables in your deployment (Render, Docker, etc). Every value here maps 1:1 to an
# ASP.NET Core configuration key - see Program.cs for exactly how each one is read.

# --- Database ---
# Production only. Development instead uses ConnectionStrings:DefaultConnection from
# appsettings.Development.json.
DATABASE_URL=

# --- JWT ---
# Development uses Jwt:Key/Issuer/Audience from appsettings.Development.json.

# --- Frontend / CORS ---
# Production only - comma-separated list of allowed origins (e.g. your Vercel deployment).
FRONTEND_URL=

# --- Supabase Storage ---
# Private buckets - create both in the Supabase dashboard first; this app never creates
# buckets itself.
#   Supabase:Url / Supabase:ServiceRoleKey / Supabase:ResumeBucket come from appsettings.
#   Supabase:EmailAttachmentBucket defaults to "email-attachments" if unset.

# --- n8n: invitations / AI screening / candidate-status emails (existing features) ---
# See appsettings.Development.json's "N8n" section for the local-dev values of these.

# --- n8n: HR Inbox module (this feature) ---
# Where this backend POSTs outbound send requests (Workflow A "Send Email" - see
# n8n/send-email.workflow.json). Use the /webhook-test/... path while the workflow is
# open in the n8n editor; switch to /webhook/... once it's saved and Active.
N8N_SEND_EMAIL_WEBHOOK_URL=http://localhost:5678/webhook-test/email-notification

# Sent as the x-webhook-secret header on every outbound request to n8n, and required on
# both inbound callbacks (POST /api/webhooks/n8n/send-result and /inbound-email) - the n8n
# workflows must be configured to send the same value back. Generate a long random string,
# e.g. `openssl rand -base64 32`.
N8N_SHARED_SECRET=

# This backend's own base URL, reachable from n8n - used to build the callbackUrl sent in
# the outbound send-email payload. If n8n runs in Docker, this MUST use
# host.docker.internal instead of localhost (e.g. http://host.docker.internal:5140),
# otherwise n8n's container can't reach your machine.
APP_BASE_URL=http://localhost:5140

# Where this backend notifies n8n right after a new inbound email is saved, so a downstream
# workflow (AI classification, resume parsing, etc) can run on it. Use the /webhook-test/...
# path while the workflow is open in the n8n editor; switch to /webhook/... once it's saved
# and Active - nothing else needs to change.
N8N_RECEIVE_EMAIL_URL=http://localhost:5678/webhook-test/receive-email

# Sent as the X-Webhook-Secret header on the request above. Generate a long random string,
# e.g. `openssl rand -base64 32`, and configure the n8n workflow to expect the same value.
N8N_WEBHOOK_SECRET=

# --- AI ("sparkle button") endpoints ---
# Optional. Leave unset and POST /api/inbox/ai/write and /ai/suggest-reply fall back to
# deterministic templated text instead of calling Claude.
ANTHROPIC_API_KEY=
