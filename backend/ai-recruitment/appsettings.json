{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "a-very-long-random-secret-key-at-least-32-chars",
    "Issuer": "ai-recruitment-hub",
    "Audience": "ai-recruitment-hub-clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "N8n": {
    "applicationSubmittedWebhookUrl": "",
    "PasswordResetWebhookUrl": "",
    // Local-development fallbacks. In every deployed environment these come from the
    // N8N_INVITATION_WEBHOOK_URL / N8N_WEBHOOK_SECRET environment variables instead,
    // which take precedence. Never commit a real secret here.
    "InvitationWebhookUrl": "",
    "WebhookSecret": "",
    // Dynamic AI screening. In production these come from N8N_SCREENING_WEBHOOK_URL /
    // N8N_SCREENING_WEBHOOK_SECRET / N8N_SCREENING_CALLBACK_SECRET instead.
    "ScreeningWebhookUrl": "",
    "ScreeningWebhookSecret": "",
    "ScreeningCallbackSecret": ""
  },
  // Used to build "{base}/set-password?token=...". Left empty here deliberately: in
  // production this is supplied by the Render environment variable Frontend__BaseUrl,
  // which ASP.NET Core's configuration binds onto this same "Frontend:BaseUrl" key.
  "Frontend": {
    "BaseUrl": ""
  },
  // Url/ServiceRoleKey are secrets supplied in every deployed environment via the
  // Supabase__Url / Supabase__ServiceRoleKey Render env vars - nothing hardcoded here.
  // ResumeBucket/SignedUrlExpirationSeconds aren't secret, so real defaults live here.
  "Supabase": {
    "ResumeBucket": "resume",
    "SignedUrlExpirationSeconds": 900
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

