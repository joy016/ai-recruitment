using ai_recruitment.Data;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Hosting;
using System.IO;
using System.Threading.Tasks;

namespace ai_recruitment.Features.Candidates
{
    [ApiController]
    [Route("api/[controller]")]
    public class CandidatesController : ControllerBase
    {

        private readonly AppDbContext _context;
        private readonly IWebHostEnvironment _env;

        public CandidatesController(AppDbContext context, IWebHostEnvironment env)
        {
            _context = context;
            _env = env;
        }

        [HttpPost]
        [Consumes("multipart/form-data")]
        public async Task<IActionResult> CreateApplicant([FromForm] InsertApplicantDto request)
        {
            if (!ModelState.IsValid) return BadRequest(ModelState);

            // Validate resume file
            var allowedExtensions = new[] { ".pdf", ".doc", ".docx" };
            const long maxFileSize = 5 * 1024 * 1024; // 5 MB

            if (request.ResumeFile == null || request.ResumeFile.Length == 0)
            {
                return BadRequest("Resume file is required.");
            }

            var ext = Path.GetExtension(request.ResumeFile.FileName).ToLowerInvariant();
            if (!allowedExtensions.Contains(ext))
            {
                return BadRequest("Invalid resume file type. Allowed: PDF, DOC, DOCX.");
            }

            if (request.ResumeFile.Length > maxFileSize)
            {
                return BadRequest("Resume file is too large. Max size is 5MB.");
            }

            string savedResumeUrl = request.ResumeUrl ?? string.Empty;

            // Save file to wwwroot/uploads
            var uploadsRoot = Path.Combine(_env.WebRootPath ?? Path.Combine(Directory.GetCurrentDirectory(), "wwwroot"), "uploads");
            if (!Directory.Exists(uploadsRoot)) Directory.CreateDirectory(uploadsRoot);

            var uniqueFileName = $"{Guid.NewGuid()}{ext}";
            var filePath = Path.Combine(uploadsRoot, uniqueFileName);

            await using (var stream = System.IO.File.Create(filePath))
            {
                await request.ResumeFile.CopyToAsync(stream);
            }

            // Use relative path for serving static files
            savedResumeUrl = $"/uploads/{uniqueFileName}";

            var applicant = new Applicant
            {
                // Id will be generated by DB default (gen_random_uuid)
                EmailAddress = request.EmailAddress,
                FirstName = request.FirstName,
                LastName = request.LastName,
                PhoneNumber = request.PhoneNumber,
                YearsOfExperience = request.YearsOfExperience,
                LinkedInProfile = request.LinkedInProfile,
                CoverLetter = request.CoverLetter,
                ResumeUrl = savedResumeUrl,
                ApplicantStatusId = request.ApplicantStatusId > 0 ? request.ApplicantStatusId : 1
            };

            _context.Applicants.Add(applicant);','explanation':'Restore assignment of ApplicantStatusId with a server-side default of 1 when request does not provide a positive id.'}  The tool will only replace ONE occurrence of oldString with newString in the specified file. Please ensure oldString matches exactly.{
            await _context.SaveChangesAsync();

            return CreatedAtAction(nameof(CreateApplicant), new { id = applicant.Id }, applicant);
        }

    }
}
