using ai_recruitment.Data;
using Microsoft.AspNetCore.Mvc;

namespace ai_recruitment.Features.Candidates
{
    [ApiController]
    [Route("api/[controller]")]
    public class CandidatesController : ControllerBase
    {

        private readonly AppDbContext _context;

        public CandidatesController(AppDbContext context)
        {
            _context = context;
        }

        [HttpPost]
        public IActionResult CreateApplicant([FromBody] InsertApplicantDto request)
        {
         
            if (!ModelState.IsValid) return BadRequest(ModelState);
            
            var candidate = new InsertApplicantDto
            {
                EmailAddress = request.EmailAddress,
                FirstName = request.FirstName,
                LastName = request.LastName,
                YearsOfExperience = request.YearsOfExperience,
                LinkedInProfile = request.LinkedInProfile,
                ResumeUrl = request.ResumeUrl,
                //ApplicantStatusId = request.ApplicantStatusId,
                //InterviewSched = request.InterviewSched
            };


            // Return 201 Created status with the resource location and object
            return CreatedAtAction(nameof(CreateApplicant), new { id = newId }, request);
        }

    }
}
