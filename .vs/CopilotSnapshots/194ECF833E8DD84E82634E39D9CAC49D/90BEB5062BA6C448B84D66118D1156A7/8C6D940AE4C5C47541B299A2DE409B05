using ai_recruitment.Data;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;

namespace ai_recruitment.Features.ApplicationStatuses
{
    public class ApplicantStatusController : Controller
    {
        private readonly AppDbContext _context;

        // GET: api/products
        [HttpGet]
        public async Task<ActionResult<IEnumerable<ApplicantStatus>>> GetStatus()
        {
            // Use EF Core to pull all records from the Products table asynchronously
            return await _context.Products.ToListAsync();
        }

    }
}
