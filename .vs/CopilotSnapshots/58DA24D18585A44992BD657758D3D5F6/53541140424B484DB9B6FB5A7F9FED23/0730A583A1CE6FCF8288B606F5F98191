using Microsoft.AspNetCore.Mvc;

namespace ai_recruitment.Features.JobPosts.Controller
{

    [ApiController]
    [Route("api/[controller]")]
    public class InsertJobController : ControllerBase
    {

        [HttpPost]
        public IActionResult InsertJob([FromBody] Dto.InsertJobDto jobDto)
        {
            if(jobDto == null)
            {
                return BadRequest("Job data is required.");
            }
            return Ok(new
            {
                Message = "Job inserted successfully",
                JobDetails = jobDto
            });
        }


    }
}
